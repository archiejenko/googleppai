VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── Edge Function CORS ────────────────────────────────────────────────────────
# Your app's domain — edge functions block cross-origin requests if unset
# e.g. https://app.yourdomain.com (no trailing slash)
ALLOWED_ORIGIN=

# ── PostHog Product Analytics ─────────────────────────────────────────────────
# Get your key from app.posthog.com → Project Settings → API Keys
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: self-hosted PostHog instance (defaults to app.posthog.com)
# VITE_POSTHOG_HOST=https://your-posthog-instance.com

# ── Revenue Intelligence & Live Scoring ─────────────────────────────────────
# Secret used to verify inbound telephony webhooks (Aircall / JustCall / RingCentral)
TELEPHONY_WEBHOOK_SECRET=your_webhook_hmac_secret

# Speech-to-text provider for live scoring: 'whisper' (default, chunked) or 'deepgram' (streaming)
STT_PROVIDER=whisper

# Required if STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key

# Minimum call duration in seconds before scoring activates (default: 90)
LIVE_SCORING_MIN_DURATION_SECS=90
